# Public site URL (used for Stripe redirects + staff email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Calendar (service account)
# 1. Create a Google Cloud project → enable Google Calendar API
# 2. Create a Service Account → download JSON key
# 3. Share your Embassy Google Calendar with the service account email
#    (Permission: "Make changes to events")
GOOGLE_SERVICE_ACCOUNT_EMAIL=booking-bot@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=primary_or_calendar_id@group.calendar.google.com

# Resend
# 1. Create API key at https://resend.com
# 2. Verify your sending domain (e.g. ethioembassy.org.uk)
RESEND_API_KEY=re_xxxxxxxx
BOOKING_FROM_EMAIL="Embassy of Ethiopia London <bookings@your-verified-domain.com>"
BOOKING_NOTIFY_EMAIL=london.embassy@mfa.gov.et

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Vercel Blob (document + case storage in production)
# Locally, cases fall back to .data/cases/ when this is unset
BLOB_READ_WRITE_TOKEN=vercel_blob_xxx

# Staff / admin console (/admin/login)
STAFF_USERNAME=admin
STAFF_EMAIL=admin@example.com
STAFF_ACCESS_PASSWORD=change-me-strong-password
# Optional dedicated signing secret (defaults to STAFF_ACCESS_PASSWORD)
# STAFF_SESSION_SECRET=long-random-string
